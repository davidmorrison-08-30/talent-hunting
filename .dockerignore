# Keep the build context small and keep secrets out of the image.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Secrets: never bake credentials into the image.
.env
.env.*
!.env.example

# Local data / logs
*.log
.DS_Store

# Helper docs that are not part of the runtime image.
build-docs/
aws-deploy-docs/
.agent_chat_history/

# Local infra overrides (docker-compose is used for local Postgres only).
docker-compose.yml
