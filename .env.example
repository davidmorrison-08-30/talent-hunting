# --- Application -------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talent_hunting
DB_ECHO=false

# --- X API (OAuth 2.0 user context) -------------------------------------
# From https://developer.x.com -> your app -> Keys and tokens
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/auth/x/callback
# Optional app-only bearer token (read-only endpoints)
X_BEARER_TOKEN=
X_SCOPES=

# --- AWS Bedrock --------------------------------------------------------
AWS_BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
AWS_DEFAULT_PROFILE=

# --- Pacing / compliance ------------------------------------------------
DM_DAILY_CAP=
DM_MIN_DELAY_SECONDS=
DM_MAX_DELAY_SECONDS=
DM_SIMILARITY_THRESHOLD=
DM_POLL_INTERVAL_SECONDS=
DISCOVERY_SPEND_CEILING_USD=

# --- Runtime ------------------------------------------------------------
RUN_MIGRATIONS_ON_STARTUP=
ENABLE_DISPATCHER=
